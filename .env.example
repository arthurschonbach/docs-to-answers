# Required. Postgres with pgvector (Neon). On Vercel, add Neon from the
# Storage tab and this is set for you; locally, `vercel env pull .env.local`.
DATABASE_URL=

# Required. OpenRouter API key, used for embeddings and answers (the
# defaults are free models).
OPENAI_API_KEY=

# Optional. Defaults to https://openrouter.ai/api/v1
# OPENAI_BASE_URL=

# Optional. Any OpenRouter chat model id, e.g. deepseek/deepseek-v4.1-flash
# (paid: the key needs a spending limit above $0).
# Defaults to nvidia/nemotron-3.5-super-vl:free.
# OPENAI_MODEL=

# Optional. Tried when the primary model's provider errors.
# Defaults to nvidia/nemotron-3.5-lightning:free.
# OPENAI_FALLBACK_MODEL=

# Optional. OpenRouter embedding model (must support 1024 dimensions).
# Defaults to nvidia/nemotron-3.5-embed-1b:free. Changing it requires
# re-importing documents.
# EMBEDDING_MODEL=
