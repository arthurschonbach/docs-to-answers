# Required for answering questions and running evals. Without it, you can
# still seed + browse sample docs, but Ask / Evals show a notice.
# Set this to your OpenRouter API key (free-tier keys work).
OPENAI_API_KEY=

# Optional. Defaults to https://openrouter.ai/api/v1
# OPENAI_BASE_URL=

# Optional. Any OpenRouter chat model id. Must be a free-tier id if your
# key can't pay. Defaults to nvidia/nemotron-3.5-super-vl:free.
# OPENAI_MODEL=

# Optional. Tried when the primary model's provider errors.
# Defaults to google/gemma-4-31b-it:free.
# OPENAI_FALLBACK_MODEL=

# Embeddings are LOCAL (Transformers.js, all-MiniLM-L6-v2) - no key needed,
# no cost, works offline. The model downloads once into ./data/models.

# Optional. Defaults to ./data/docs.db
# DATABASE_PATH=
